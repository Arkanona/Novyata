PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5174
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
OPENAI_API_KEY=
